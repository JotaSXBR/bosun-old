{
  "$schema": "https://turbo.build/schema.json",
  "cacheMaxSize": "10GB",
  "cacheMaxAge": "7d",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {},
    "test:integration": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    }
  }
}
